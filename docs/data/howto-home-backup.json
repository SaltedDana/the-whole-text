n","label":"Testing restores and scheduling runs","start":27,"end":39},{"type":"explanation","label":"Quarterly checks and drive age","start":40,"end":47},{"type":"summary","label":"Routine protects everything important","start":48,"end":49}]},"stats":{"words":623,"sentences":49,"paragraphs":13,"candidates":76,"accepted_by_code":23,"open":4},"usage":{"model":"claude-haiku-5-5","input_tokens":3346,"output_tokens":439,"calls":2,"ms":2431}}